{
    "name": "rotulo",
    "version": "0.3.0",
    "description": "Monoline typeface generated from skeletons: strokes of lines and arcs expanded with a round pen.",
    "keywords": [
        "font",
        "typeface",
        "monoline",
        "cartography",
        "map-labels",
        "woff2",
        "maplibre",
        "glyphs"
    ],
    "license": "OFL-1.1",
    "author": "Edgar Villarreal",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GHEgar/rotulo.git",
        "directory": "web"
    },
    "homepage": "https://github.com/GHEgar/rotulo#readme",
    "bugs": {
        "url": "https://github.com/GHEgar/rotulo/issues"
    },
    "style": "./rotulo.css",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./rotulo.css"
        },
        "./rotulo.css": "./rotulo.css",
        "./fonts/*": "./fonts/*",
        "./glyphs/*": "./glyphs/*"
    },
    "files": [
        "rotulo.css",
        "index.d.ts",
        "fonts",
        "glyphs"
    ],
    "types": "./index.d.ts",
    "scripts": {
        "glyphs": "node glyphs.mjs ../build/map glyphs"
    },
    "devDependencies": {
        "fontnik": "0.7.7"
    }
}
